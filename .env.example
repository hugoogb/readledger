# Database. On the VPS, new-app.sh generates both:
# runtime queries go through PgBouncer (transaction pooling)...
DATABASE_URL="postgresql://readledger:password@localhost:5432/readledger"
# ...and migrations connect to Postgres directly.
DIRECT_URL="postgresql://readledger:password@localhost:5432/readledger"

# Auth: HMAC key for login codes. Generate with: openssl rand -base64 48
AUTH_SECRET=""

# Email (Brevo transactional API). Without BREVO_API_KEY in development,
# login codes are printed to the server log instead of emailed.
BREVO_API_KEY=""
EMAIL_FROM="login@readledger.app"
EMAIL_FROM_NAME="ReadLedger"
