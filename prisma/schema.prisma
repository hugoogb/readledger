generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  name         String?
  avatarUrl    String?
  currency     String        @default("EUR")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  series       Series[]
  publishers   Publisher[]
  stores       UserStore[]
  sessions     Session[]
  readingGoals ReadingGoal[]

  @@map("users")
}

/// One-time login codes. Only an HMAC of the code is stored. `consumedAt` is
/// set when a code is used *or* superseded by a newer one, so at most one
/// code per email is ever live. Rows are kept ~1 day for send throttling.
model OtpCode {
  id         String    @id @default(uuid())
  email      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
  @@map("otp_codes")
}

/// Login sessions. The cookie holds a random token; only its SHA-256 is stored.
model Session {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Yearly reading target (number of volumes), one per user per year.
model ReadingGoal {
  id        String   @id @default(uuid())
  userId    String
  year      Int
  target    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year])
  @@map("reading_goals")
}

model Publisher {
  id        String   @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  series    Series[]

  @@unique([userId, name])
  @@map("publishers")
}

model UserStore {
  id        String   @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  volumes   Volume[]

  @@unique([userId, name])
  @@map("user_stores")
}

model Series {
  id           String       @id @default(uuid())
  userId       String
  title        String
  author       String?
  status       SeriesStatus @default(READING)
  totalVolumes Int?
  coverImage   String?
  description  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  retailPrice  Float?
  mangadexId   String?
  publishing   Boolean      @default(false)
  publisherId  String?
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  publisher    Publisher?   @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  volumes      Volume[]

  @@unique([userId, mangadexId])
  @@map("series")
}

model Volume {
  id           String     @id @default(uuid())
  seriesId     String
  volumeNumber Int
  owned        Boolean    @default(false)
  read         Boolean    @default(false)
  wishlist     Boolean    @default(false)
  pricePaid    Float?
  condition    Condition?
  purchaseDate DateTime?
  readDate     DateTime?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  isbn         String?
  coverImage   String?
  title        String?
  storeId      String?
  series       Series     @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  store        UserStore? @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@unique([seriesId, volumeNumber])
  @@map("volumes")
}

enum SeriesStatus {
  READING
  COMPLETED
  ON_HOLD
  DROPPED
  PLAN_TO_READ
}

enum Condition {
  NEW
  LIKE_NEW
  VERY_GOOD
  GOOD
  ACCEPTABLE
  POOR
}
