generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String      @id @default(uuid())
  email      String      @unique
  name       String?
  avatarUrl  String?
  currency   String      @default("EUR")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  series     Series[]
  publishers Publisher[]
  stores     UserStore[]

  @@map("users")
}

model Publisher {
  id        String   @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  series    Series[]

  @@unique([userId, name])
  @@index([userId])
  @@map("publishers")
}

model UserStore {
  id        String   @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  volumes   Volume[]

  @@unique([userId, name])
  @@index([userId])
  @@map("user_stores")
}

model Series {
  id           String       @id @default(uuid())
  userId       String
  title        String
  author       String?
  status       SeriesStatus @default(READING)
  totalVolumes Int?
  coverImage   String?
  description  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  retailPrice  Float?
  mangadexId   String?
  publishing   Boolean      @default(false)
  publisherId  String?
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  publisher    Publisher?   @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  volumes      Volume[]

  @@unique([userId, mangadexId])
  @@index([userId])
  @@index([userId], map: "idx_series_userid")
  @@map("series")
}

model Volume {
  id           String     @id @default(uuid())
  seriesId     String
  volumeNumber Int
  owned        Boolean    @default(false)
  read         Boolean    @default(false)
  wishlist     Boolean    @default(false)
  pricePaid    Float?
  condition    Condition?
  purchaseDate DateTime?
  readDate     DateTime?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  isbn         String?
  coverImage   String?
  title        String?
  storeId      String?
  series       Series     @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  store        UserStore? @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@unique([seriesId, volumeNumber])
  @@index([seriesId])
  @@index([seriesId], map: "idx_volumes_seriesid")
  @@map("volumes")
}

enum SeriesStatus {
  READING
  COMPLETED
  ON_HOLD
  DROPPED
  PLAN_TO_READ
}

enum Condition {
  NEW
  LIKE_NEW
  VERY_GOOD
  GOOD
  ACCEPTABLE
  POOR
}
